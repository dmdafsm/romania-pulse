@{
    var current = ViewData["Nav"] as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The pulse of the Romanian economy: growth, jobs, prices, trade and public finances from official public data." />
    <meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false,"selfRequestsOnly":true}' />
    <title>@ViewData["Title"] · Romania Pulse</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/beercss@5.0.3/dist/cdn/beer.min.css"
          integrity="sha384-EqZ6IXmk+4jeYN6dm7SEK3B8T8AMiHLEujTTup/LU1rSEjt1Ce8Vz8uI6NQ8czHg" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
        <div class="site-bar">
            <a class="brand" href="/">
                <svg viewBox="0 0 32 20" width="32" height="20" aria-hidden="true" focusable="false">
                    <path d="M1 11h7l3-8 5 15 4-11 2 4h9" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>Romania Pulse</span>
            </a>
            <button id="theme-toggle" class="border small round" type="button" aria-label="Switch between light and dark theme">Theme</button>
        </div>
        <nav class="site-nav" aria-label="Sections">
            <a href="/" class="@(current == "overview" ? "active" : null)" aria-current="@(current == "overview" ? "page" : null)">Overview</a>
            @foreach (var topic in IndicatorCatalog.Sections)
            {
                <a href="/section/@topic.Slug" class="@(current == topic.Slug ? "active" : null)" aria-current="@(current == topic.Slug ? "page" : null)">@topic.Title</a>
            }
            <a href="/sources" class="@(current == "sources" ? "active" : null)" aria-current="@(current == "sources" ? "page" : null)">Data sources</a>
        </nav>
    </header>
    <main id="content" class="responsive">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <p>
            Figures come from <a href="https://ec.europa.eu/eurostat" rel="noopener">Eurostat</a> and the
            <a href="https://www.bnr.ro/" rel="noopener">National Bank of Romania</a> and are shown as published, without adjustment.
            <a href="/sources">About the data</a>. Not financial advice.
        </p>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js"
            integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.6.1/dist/chart.umd.min.js"
            integrity="sha384-Emf5ZVIUiarAdhkgtqK+5/Z5qIvM6QoVrS+qAVtfyZVuD5lIHrac0me485+Antp0" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
